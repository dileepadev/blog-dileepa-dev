---
import { seriesRegistry } from "../data/series";

interface Props {
  seriesKey: string;
  current: number;
}

const { seriesKey, current } = Astro.props;
const series = seriesRegistry[seriesKey];

if (!series) {
  throw new Error(`Unknown series key: ${seriesKey}`);
}
---

<div class="not-prose my-8 rounded-xl border border-border-light bg-bg-secondary p-6">
  <p class="text-xs font-bold uppercase tracking-wider text-accent-blue mb-1">
    Series · {series.title}
  </p>
  <p class="text-sm text-text-muted mb-4">{series.description}</p>
  <ol class="space-y-3">
    {
      series.parts.map((part) => {
        const isCurrent = part.order === current;
        const badgeClass = isCurrent
          ? "bg-accent-blue text-white"
          : part.slug
            ? "bg-accent-blue/10 text-accent-blue"
            : "bg-border-light text-text-muted";
        return (
          <li class="flex items-start gap-3">
            <span
              class={`mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-xs font-bold ${badgeClass}`}
            >
              {part.order}
            </span>
            <div>
              {part.slug ? (
                <a
                  href={`/blog/${part.slug}`}
                  class="font-medium text-text-primary hover:text-accent-blue transition-colors"
                >
                  {part.title}
                </a>
              ) : (
                <span class="font-medium text-text-primary">
                  {part.title}
                </span>
              )}
              {isCurrent && (
                <span class="ml-2 text-xs font-bold uppercase tracking-wider text-accent-blue">
                  You are here
                </span>
              )}
              {!part.slug && (
                <span class="ml-2 text-xs font-bold uppercase tracking-wider text-text-muted">
                  Coming soon
                </span>
              )}
              <p class="text-sm text-text-muted mt-0.5">{part.blurb}</p>
            </div>
          </li>
        );
      })
    }
  </ol>
</div>
